rules_version = '2';
// Cole este arquivo em: console do Firebase > Firestore Database > Regras > Publicar.
// Troque o e-mail abaixo pelo e-mail da conta Google do mestre (o mesmo do config.js).
service cloud.firestore {
  match /databases/{database}/documents {
    function logado() { return request.auth != null; }
    function mestre() { return logado() && request.auth.token.email in ['bksapiens007@gmail.com']; }

    // Ficha e estado de cada jogador: todos leem, só o dono (ou o mestre) escreve.
    match /fichas/{uid} {
      allow read: if logado();
      allow write: if logado() && (request.auth.uid == uid || mestre());
    }
    match /jogadores/{uid} {
      allow read: if logado();
      allow write: if logado() && (request.auth.uid == uid || mestre());
    }

    // Chat, combates e missões são compartilhados entre os jogadores logados.
    match /canais/{local}/msgs/{msg} {
      allow read, write: if logado();
    }
    match /combates/{local} {
      allow read, write: if logado();
    }
    match /missoes/{id} {
      allow read, write: if logado();
    }

    // Ienes mandados entre jogadores (quem recebe marca como aplicada).
    match /transferencias/{id} {
      allow read, create, update: if logado();
      allow delete: if mestre();
    }
    // Livro de NPCs: o mestre de IA anota; só o mestre humano apaga.
    match /npcs/{id} {
      allow read, create, update: if logado();
      allow delete: if mestre();
    }
    // Acontecimentos da linha do tempo: qualquer jogador logado pode registrar um acontecimento novo
    // (é assim que a história avança sozinha), mas só o mestre altera ou apaga.
    match /eventos/{id} {
      allow read, create: if logado();
      allow update, delete: if mestre();
    }
    // Mensagens diretas: só os dois jogadores da conversa (o id da conversa é "uidA__uidB").
    match /dms/{conversa}/msgs/{msg} {
      allow read, create: if logado() && request.auth.uid in conversa.split('__');
      allow delete: if mestre();
    }
    // Convite de um aluno para um freelancer entrar na escola (id "uidDoFreelancer__escola").
    match /convites/{id} {
      allow read: if logado();
      allow create, update: if logado() && request.resource.data.de == request.auth.uid;
      allow delete: if mestre() || (logado() && (resource.data.de == request.auth.uid || resource.data.para == request.auth.uid));
    }
    // Rede social (Sussurros): todos leem; cada um posta em nome próprio; qualquer um curte; só o autor ou o mestre apaga.
    match /posts/{id} {
      allow read: if logado();
      allow create: if logado() && request.resource.data.autor == request.auth.uid && request.resource.data.texto is string && request.resource.data.texto.size() <= 280;
      allow update: if logado() && (resource.data.autor == request.auth.uid || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['curtidas']));
      allow delete: if mestre() || (logado() && resource.data.autor == request.auth.uid);
    }
    // Estado da campanha (fase, semana dos olhos, direção do mestre): só o mestre escreve.
    match /config/{id} {
      allow read: if logado();
      allow write: if mestre();
    }
  }
}
